{
    "name": "videlic/examples-phpunit",
    "description": "PHP test project with PHPUnit",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "psr/log": "^3.0 || dev-passacc678"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
